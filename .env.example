MODEL_DIR=/models
NSA_ROUTER_TOP_K=3
NSA_CASCADE_CONFIDENCE_THRESHOLD=0.85
# c4a-standard-8 = 8 vCPU / 32 GB. Keep thread sum <= 8 and MVP ctx at 4096.
TIER1_THREADS=2
TIER2_THREADS=3
TIER3_THREADS=3
TIER1_CTX=4096
TIER2_CTX=4096
TIER3_CTX=4096
NSA_VM_HOURLY_COST_USD=
NSA_IMAGE_TAG=dev
GRAFANA_ADMIN_USER=admin
# Set this in .env before exposing Grafana outside the VM.
GRAFANA_ADMIN_PASSWORD=

# KV Memory Runtime (Plane 2)
NSA_KV_STORE=work/kv
NSA_KV_BLOCK_SIZE=256
NSA_KV_RAM_BUDGET=536870912
NSA_KV_PRESSURE_THRESHOLD=0.70
NSA_KV_COMPRESSION=zstd
NSA_KV_SHARING_BACKEND=mmap
NSA_KV_REDIS_URL=redis://localhost:6379/0
NSA_KV_BG_MIGRATION=1
