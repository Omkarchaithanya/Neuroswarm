# Copy to terraform.tfvars (gitignored) — do not commit live project IDs.
project_id    = "YOUR_GCP_PROJECT_ID"
region        = "us-central1"
zone          = "us-central1-a"
instance_name = "neuroswarm-axion"
machine_type  = "c4a-standard-8"

# Replace with your current public IP /32.
source_ranges = ["203.0.113.10/32"]
