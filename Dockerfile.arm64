# syntax=docker/dockerfile:1
FROM --platform=linux/arm64 python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NSA_HOST=0.0.0.0 \
    NSA_PORT=8000 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_SYSTEM_PYTHON=1 \
    PATH="/usr/local/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv (lean gateway — lockfile frozen, not --all-groups).
COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock README.md LICENSE /app/
COPY packages/okf /app/packages/okf
COPY neuroswarm_arm /app/neuroswarm_arm
COPY templates /app/templates
COPY okf /app/okf

# Lockfile-true lean install: only dependency-groups.gateway + editable packages.
RUN uv sync --frozen --no-dev --no-install-project --only-group gateway \
    && uv pip install --python /usr/local --no-cache --no-deps -e /app/packages/okf \
    && uv pip install --python /usr/local --no-cache --no-deps -e /app

EXPOSE 8000
CMD ["python", "-m", "neuroswarm_arm.main"]
