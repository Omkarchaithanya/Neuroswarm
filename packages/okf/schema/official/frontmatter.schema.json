{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-arm.dev/okf/official/frontmatter.schema.json",
  "title": "Google OKF v0.1 Frontmatter (Official)",
  "description": "Origin: Official OKF. type is free-form string. No enum. Unknown keys allowed.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Short string identifying the concept kind. Not centrally registered."
    },
    "title": {"type": "string"},
    "description": {"type": "string"},
    "resource": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "description": "ISO 8601 datetime"}
  },
  "additionalProperties": true
}
