{
  "uid": "rmf-arm-hardware",
  "title": "RMF ARM Hardware Dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": [
    "nexus",
    "rmf"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nexus_hw_cpu_usage",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU frequency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
