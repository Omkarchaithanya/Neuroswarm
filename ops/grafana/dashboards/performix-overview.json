{
  "uid": "performix-overview",
  "title": "Arm Performix Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "tags": ["nexus", "performix", "arm"],
  "description": "Canonical job=neuroswarm-gateway (Compose :80). PMU=0 means no hardware counters. Top-down panels are last Performix snapshot gauges, not live PMU.",
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "How to read this board",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "**Canonical scrape:** `{job=\"neuroswarm-gateway\"}` (Compose nginx :80). Do not run k3s alongside Compose.\n\n**PMU available = 0** is expected without real hardware counters. **Code hotspots** need `nexus_performix_hotspot_pct{function=...}` from a PID-scoped `apx` capture under chat load.\n\n**Top-down** panels are last snapshot gauges — check **Snapshot age**."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Performix available",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_available{job=\"neuroswarm-gateway\"}", "legendFormat": "available"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "No"}, "1": {"text": "Yes"}}}]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PMU available",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_pmu_available{job=\"neuroswarm-gateway\"}", "legendFormat": "pmu"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "No HW"}, "1": {"text": "Yes"}}}]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "IPC",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_ipc{job=\"neuroswarm-gateway\"}", "legendFormat": "ipc"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Top hotspot %",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_hotspot_top_pct{job=\"neuroswarm-gateway\"}", "legendFormat": "top"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hotspot count",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_hotspot_count{job=\"neuroswarm-gateway\"}", "legendFormat": "n"}]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Snapshot age (s)",
      "description": "Seconds since work/performix/snapshot.json mtime. Top-down panels below are last capture, not live PMU.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 3},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nexus_performix_snapshot_age_seconds{job=\"neuroswarm-gateway\"}", "legendFormat": "age"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "IPC / cycles / instructions (gauges)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "nexus_performix_ipc{job=\"neuroswarm-gateway\"}", "legendFormat": "ipc"},
        {"refId": "B", "expr": "nexus_performix_cycles{job=\"neuroswarm-gateway\"}", "legendFormat": "cycles"},
        {"refId": "C", "expr": "nexus_performix_instructions{job=\"neuroswarm-gateway\"}", "legendFormat": "instructions"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache / branch misses",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "nexus_performix_cache_misses{job=\"neuroswarm-gateway\"}", "legendFormat": "cache_misses"},
        {"refId": "B", "expr": "nexus_performix_branch_misses{job=\"neuroswarm-gateway\"}", "legendFormat": "branch_misses"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Last Performix capture (snapshot) — frontend / backend bound",
      "description": "One-shot gauges from snapshot.json, not continuous PMU. See Snapshot age.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "nexus_performix_frontend_bound{job=\"neuroswarm-gateway\"}", "legendFormat": "frontend_bound"},
        {"refId": "B", "expr": "nexus_performix_backend_bound{job=\"neuroswarm-gateway\"}", "legendFormat": "backend_bound"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Code hotspots (top functions)",
      "description": "Requires labeled series nexus_performix_hotspot_pct{function=...}. If empty: run PID-scoped apx under chat load.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, nexus_performix_hotspot_pct{job=\"neuroswarm-gateway\"})",
          "legendFormat": "{{function}}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {"id": "labelsToFields", "options": {"valueLabel": "Value"}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "service": true
            },
            "renameByName": {
              "function": "Function",
              "Value": "Hotspot %"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto"},
          "noValue": "No hotspot series — run Performix recipe or check /metrics for nexus_performix_hotspot_pct"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RPF runtime profiling (CPU / RSS)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "nexus_hw_cpu_usage{job=\"neuroswarm-gateway\"}", "legendFormat": "cpu"},
        {"refId": "B", "expr": "nexus_memory_rss_bytes{job=\"neuroswarm-gateway\"}", "legendFormat": "rss"}
      ]
    }
  ]
}
