{
  "title": "ROF Backend Dashboard",
  "uid": "rof-backend",
  "tags": ["rof", "backend"],
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Backend Selected",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_backend_selected_total", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inference Duration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_inference_duration_seconds_last", "refId": "A"}]
    }
  ]
}
