{
  "uid": "ascr-overview",
  "title": "ASCR / ArmCascade Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["nexus", "ascr", "armcascade"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Acceptance rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ascr_acceptance_rate or nexus_ascr_acceptance_rate",
          "legendFormat": "accept"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Speculation gain (0 = text-agree / quality cascade)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ascr_speculation_gain or nexus_ascr_speculation_gain",
          "legendFormat": "gain"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Quality cascade total",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ascr_quality_cascade_total or nexus_ascr_quality_cascade_total",
          "legendFormat": "quality_cascade"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DIPA cascade hit rate (tier-1 finish)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dipa_cascade_hit_rate or nexus_dipa_cascade_hit_rate",
          "legendFormat": "hit_rate"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Text agreement (interim accept mode)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ascr_text_agreement or nexus_ascr_text_agreement",
          "legendFormat": "text_agree"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ASCR rounds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ascr_rounds_total or nexus_ascr_rounds_total",
          "legendFormat": "rounds"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
