{
  "title": "ROF Model Dashboard",
  "uid": "rof-model",
  "tags": ["rof", "model"],
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prompt Tokens",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_prompt_tokens", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completion Tokens",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_completion_tokens", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reasoning Tokens",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_reasoning_tokens", "refId": "A"}]
    }
  ]
}
