{
  "title": "ROF Hardware / Performix",
  "uid": "rof-hardware",
  "tags": ["rof", "performix", "arm"],
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Seconds",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_cpu_seconds", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Energy Estimate",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_energy_estimate", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peak Memory",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "nexus_peak_memory_bytes", "refId": "A"}]
    }
  ]
}
